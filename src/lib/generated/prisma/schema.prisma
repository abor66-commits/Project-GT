// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  password        String // Store hashed password here
  role            String  @default("SALES") // SALES, MARKETING, MANAGER, ASSISTANT, SSO, ADMIN
  status          String  @default("PENDING") // PENDING, APPROVED, REJECTED, DISABLED
  department      String?
  employeeId      String? @unique @map("employee_id")
  jobTitle        String? @map("job_title")
  region          String? // 負責區域: 台灣, 香港, 日本, 東南亞
  defaultLanguage String  @default("zh-TW") @map("default_language")
  exclusiveMode   Boolean @default(true) @map("exclusive_mode")

  companies          Company[]           @relation("Owner")
  activities         Activity[]
  opportunities      Opportunity[]
  createdContacts    Contact[]           @relation("ContactCreator")
  broadcastCampaigns BroadcastCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id          String  @id @default(cuid())
  name        String
  region      String? // 客戶所在地區域
  platform    String? // Azure, AWS, GCP
  industry    String
  sizeScale   String  @map("size_scale")
  website     String?
  domain      String? @unique // 從名片 Email 擷取的網域，用於自動歸檔比對
  salesDeputy String? @map("sales_deputy") // 業務代理人
  status      String  @default("POTENTIAL") // POTENTIAL, ACTIVE

  ownerId String @map("owner_id")
  owner   User   @relation("Owner", fields: [ownerId], references: [id])

  cloudSpendEst    Float?    @map("cloud_spend_est") // 預估月雲端支出金額 (USD)
  cloudRenewalDate DateTime? @map("cloud_renewal_date") // 合約續約或到期時間
  technographics   String? // 技術堆疊，例如 "AWS, Kubernetes, Datadog" (逗號分隔)
  priorityScore    String?   @map("priority_score") // 優先級評分 (HIGH, MEDIUM, LOW)

  contacts      Contact[]
  opportunities Opportunity[]
  tags          Tag[]         @relation("CompanyTags")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id          String  @id @default(cuid())
  companyId   String  @map("company_id")
  company     Company @relation(fields: [companyId], references: [id])
  name        String
  jobTitle    String? @map("job_title")
  phone       String?
  email       String?
  linkedinUrl String? @map("linkedin_url")
  isPrimary   Boolean @default(false) @map("is_primary")
  tags        Tag[]   @relation("ContactTags")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("ContactCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Activity {
  id      String @id @default(cuid())
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  relatedType String @map("related_type") // COMPANY, CONTACT
  relatedId   String @map("related_id")

  type    String // CALL, EMAIL, MEETING
  content String

  createdAt DateTime @default(now())
}

model Opportunity {
  id        String   @id @default(cuid())
  name      String
  amount    Float
  stage     String   @default("PROSPECTING") // PROSPECTING, QUALIFICATION, PROPOSAL...
  closeDate DateTime @map("close_date")

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  source   String? // e.g. FB, LinkedIn, Seminar
  campaign String? // e.g. Summer_Sale_2024

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  userName   String   @map("user_name")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    String?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now())
}

model Tag {
  id          String    @id @default(cuid())
  name        String    @unique
  color       String? // For visual identification
  description String? // 備註與規則用法
  companies   Company[] @relation("CompanyTags")
  contacts    Contact[] @relation("ContactTags")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
}

model AutomationRule {
  id          String   @id @default(cuid())
  name        String
  triggerType String // e.g., "TAG_ADDED"
  triggerVal  String // e.g., "Potential" (the tag name)
  actionType  String // e.g., "SEND_EMAIL"
  templateId  String? // Optional reference to a template
  content     String? // Inline content/subject if no template
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingLog {
  id        String   @id @default(cuid())
  type      String // e.g., "EMAIL_BROADCAST", "AUTOMATION_TRIGGER"
  target    String // e.g., Tag name or Rule name
  details   String? // e.g., "Sent to 50 recipients"
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String // 模板名稱
  subject     String? // 預設主旨（選填）
  content     String // HTML 內容
  isShared    Boolean  @default(false) @map("is_shared") // 是否共用給所有人
  createdById String   @map("created_by_id") // 建立者 user id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BroadcastCampaign {
  id               String               @id @default(cuid())
  subject          String
  tagName          String               @map("tag_name")
  templateId       String?              @map("template_id")
  senderId         String               @map("sender_id")
  sender           User                 @relation(fields: [senderId], references: [id])
  totalRecipients  Int                  @default(0) @map("total_recipients")
  successCount     Int                  @default(0) @map("success_count")
  failedCount      Int                  @default(0) @map("failed_count")
  openCount        Int                  @default(0) @map("open_count")
  uniqueOpenCount  Int                  @default(0) @map("unique_open_count")
  clickCount       Int                  @default(0) @map("click_count")
  uniqueClickCount Int                  @default(0) @map("unique_click_count")
  status           String               @default("COMPLETED") // SENDING, COMPLETED, FAILED
  contentSnapshot  String?              @map("content_snapshot")
  recipients       BroadcastRecipient[]
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([senderId])
  @@index([tagName])
}

model BroadcastRecipient {
  id             String            @id @default(cuid())
  campaignId     String            @map("campaign_id")
  campaign       BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email          String
  contactName    String            @map("contact_name")
  companyName    String            @map("company_name")
  status         String            @default("SENT") // SENT, FAILED
  errorMessage   String?           @map("error_message")
  trackingToken  String            @unique @map("tracking_token")
  openedAt       DateTime?         @map("opened_at")
  lastOpenedAt   DateTime?         @map("last_opened_at")
  openCount      Int               @default(0) @map("open_count")
  clickedAt      DateTime?         @map("clicked_at")
  lastClickedAt  DateTime?         @map("last_clicked_at")
  clickCount     Int               @default(0) @map("click_count")
  lastClickedUrl String?           @map("last_clicked_url")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@index([trackingToken])
  @@index([campaignId])
  @@index([email])
}
